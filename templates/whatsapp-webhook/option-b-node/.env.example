# ──────────────────────────────────────────────────────────────────────────────
# Environment Variables for {ClientName} WhatsApp Webhook
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── META / WHATSAPP CONFIGURATION ───────────────────────────────────────────

# A random string you create. Must match what you enter in Meta's webhook config.
# Example: "my-secret-verify-token-12345"
META_VERIFY_TOKEN=

# Your WhatsApp Business API access token (from Meta App Dashboard).
# For production, use a permanent System User token from Meta Business Suite.
META_ACCESS_TOKEN=

# Your WhatsApp Business phone number ID (from Meta App Dashboard > WhatsApp > Getting Started).
# This is NOT your phone number — it's Meta's internal ID for your number.
META_PHONE_NUMBER_ID=

# ─── SALESFORCE / AGENTFORCE CONFIGURATION ────────────────────────────────────

# Your Salesforce login URL.
# Production: https://login.salesforce.com
# Sandbox: https://test.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# The Consumer Key from your External Client App (ECA) in Salesforce.
# Found in: Setup > App Manager > your connected app > Consumer Key
SF_CLIENT_ID=

# The Consumer Secret from your External Client App (ECA).
# Found in: Setup > App Manager > your connected app > Consumer Secret
SF_CLIENT_SECRET=

# The BotDefinition record ID for your Agentforce agent.
# Found in: Setup > Agents > your agent > copy the record ID from the URL
SF_AGENT_ID=

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Port for the Express server (default: 3000).
# Heroku/Railway set this automatically — you don't need to set it.
# PORT=3000
