<?xml version="1.0" encoding="UTF-8"?>
<AiSurface xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Custom connection for the {ClientName} in-app portal. Enables rich interactive responses (cards, lists, buttons, forms, carousels) within the customer's own application.</description>

    <instructions>
        <instruction>Respond with plain text for short informational answers. Use response formats only when the response benefits from structure (actionable items, multiple results, data collection, visual comparisons).</instruction>
        <sortOrder>1</sortOrder>
    </instructions>
    <instructions>
        <instruction>Never use more than one response format in a single reply. Pick the single best format for the response, or use plain text.</instruction>
        <sortOrder>2</sortOrder>
    </instructions>
    <instructions>
        <instruction>For single items with clear next actions, use InAppCard. For multiple items to scan, use InAppList. For quick choices (1-6 options), use InAppButtonGroup. For data collection, use InAppForm. For visual side-by-side comparison, use InAppCarousel.</instruction>
        <sortOrder>3</sortOrder>
    </instructions>
    <instructions>
        <instruction>Keep all text concise. Users are in an app context — they expect fast, scannable responses, not paragraphs.</instruction>
        <sortOrder>4</sortOrder>
    </instructions>

    <masterLabel>{ClientName}Portal</masterLabel>

    <responseFormats>
        <enabled>true</enabled>
        <responseFormat>{ClientName}InAppCard_{surfaceId}</responseFormat>
    </responseFormats>
    <responseFormats>
        <enabled>true</enabled>
        <responseFormat>{ClientName}InAppList_{surfaceId}</responseFormat>
    </responseFormats>
    <responseFormats>
        <enabled>true</enabled>
        <responseFormat>{ClientName}InAppButtonGroup_{surfaceId}</responseFormat>
    </responseFormats>
    <responseFormats>
        <enabled>true</enabled>
        <responseFormat>{ClientName}InAppForm_{surfaceId}</responseFormat>
    </responseFormats>
    <responseFormats>
        <enabled>true</enabled>
        <responseFormat>{ClientName}InAppCarousel_{surfaceId}</responseFormat>
    </responseFormats>

    <surfaceType>Custom</surfaceType>
</AiSurface>
