# ─── Salesforce Agent API (ECA credentials) ─────────────────────────────────
# Get these from Setup > External Client Apps in your Salesforce org.
SF_LOGIN_URL=https://yourorg.my.salesforce.com
SF_CLIENT_ID=your_eca_consumer_key
SF_CLIENT_SECRET=your_eca_consumer_secret
SF_AGENT_ID=0XxXXXXXXXXXXXX

# ─── End-User Authentication (IdP) ──────────────────────────────────────────
# Configure for your IdP. Examples below for Auth0, Okta, and SF Identity.

# Auth0:
# AUTH_JWKS_URI=https://YOUR_DOMAIN.auth0.com/.well-known/jwks.json
# AUTH_ISSUER=https://YOUR_DOMAIN.auth0.com/
# AUTH_AUDIENCE=your-api-identifier

# Okta:
# AUTH_JWKS_URI=https://YOUR_DOMAIN.okta.com/oauth2/default/v1/keys
# AUTH_ISSUER=https://YOUR_DOMAIN.okta.com/oauth2/default
# AUTH_AUDIENCE=api://default

# Salesforce Identity:
# AUTH_JWKS_URI=https://YOUR_ORG.my.salesforce.com/id/keys
# AUTH_ISSUER=https://YOUR_ORG.my.salesforce.com
# AUTH_AUDIENCE=your-connected-app-consumer-key

AUTH_JWKS_URI=
AUTH_ISSUER=
AUTH_AUDIENCE=

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173

# ─── Development Only ────────────────────────────────────────────────────────
# Set to "true" to skip auth validation during local development.
# NEVER enable in production.
# ALLOW_ANONYMOUS=true
