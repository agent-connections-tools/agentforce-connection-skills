# ──────────────────────────────────────────────────────────────────────────────
# Environment Variables for {ClientName} Instagram Webhook
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── META / INSTAGRAM CONFIGURATION ─────────────────────────────────────────

# A random string you create. Must match what you enter in Meta's webhook config.
META_VERIFY_TOKEN=

# Your Page Access Token with instagram_manage_messages permission.
# Generate from: Meta App Dashboard > Instagram > Messaging > Generate Token
META_PAGE_ACCESS_TOKEN=

# Your Meta App Secret (for webhook signature verification).
# Found in: Meta App Dashboard > Settings > Basic > App Secret
META_APP_SECRET=

# Your Instagram Professional Account ID (IGSID).
# Found in: Meta App Dashboard > Instagram > Messaging > Instagram Account ID
META_INSTAGRAM_ID=

# ─── SALESFORCE / AGENTFORCE CONFIGURATION ────────────────────────────────────

# Your Salesforce login URL.
# Production: https://login.salesforce.com
# Sandbox: https://test.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# The Consumer Key from your External Client App (ECA) in Salesforce.
SF_CLIENT_ID=

# The Consumer Secret from your External Client App (ECA).
SF_CLIENT_SECRET=

# The BotDefinition record ID for your Agentforce agent.
SF_AGENT_ID=

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Port for the Express server (default: 3000).
# PORT=3000
