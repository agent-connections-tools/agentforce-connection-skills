# ──────────────────────────────────────────────────────────────────────────────
# Environment Variables for {ClientName} Teams Webhook
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── MICROSOFT / TEAMS CONFIGURATION ─────────────────────────────────────────

# Your Bot's App ID from the Azure Bot registration.
# Found in: Azure Portal > Bot Services > your bot > Configuration > Microsoft App ID
MICROSOFT_APP_ID=

# Your Bot's App Password (client secret) from the Azure AD app registration.
# Found in: Azure Portal > App Registrations > your app > Certificates & secrets
# You set this when you created the bot — if lost, create a new secret.
MICROSOFT_APP_PASSWORD=

# ─── SALESFORCE / AGENTFORCE CONFIGURATION ────────────────────────────────────

# Your Salesforce login URL.
# Production: https://login.salesforce.com
# Sandbox: https://test.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# The Consumer Key from your External Client App (ECA) in Salesforce.
# Found in: Setup > App Manager > your connected app > Consumer Key
SF_CLIENT_ID=

# The Consumer Secret from your External Client App (ECA).
# Found in: Setup > App Manager > your connected app > Consumer Secret
SF_CLIENT_SECRET=

# The BotDefinition record ID for your Agentforce agent.
# Found in: Setup > Agents > your agent > copy the record ID from the URL
# Starts with 0Xx...
SF_AGENT_ID=

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Port for the Express server (default: 3978 — Bot Framework convention).
# Heroku/Railway set this automatically — you don't need to set it.
# PORT=3978
